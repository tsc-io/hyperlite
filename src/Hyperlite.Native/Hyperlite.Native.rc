// -*- C++ -*-
//
// Win32 version resource for the Hyperlite native companion.
//
// Deliberately plain ascii: the copyright sign arrives from the generated header as the
// escape \xA9, so this file needs no encoding beyond ascii and rc.exe cannot misread it.
//
// Every value comes from Hyperlite.version.h, generated from Version.props by the
// GenerateVersionHeader target in Hyperlite.Native.vcxproj. Do not write a version here.

// VS_VERSION_INFO and the VFT_ constants. Without this include rc.exe does not fail - it
// treats VS_VERSION_INFO as a resource *name*, so the block is emitted as a string named
// resource rather than numeric id 1 under RT_VERSION, and FileVersionInfo finds nothing.
#include <winresrc.h>

#include "Hyperlite.version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HYPERLITE_VERSION_COMMA
 PRODUCTVERSION HYPERLITE_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", HYPERLITE_COMPANY_STR
            VALUE "FileDescription", "Hyperlite native companion"
            VALUE "FileVersion", HYPERLITE_VERSION_STR
            VALUE "InternalName", HYPERLITE_ORIGINAL_FILENAME
            VALUE "LegalCopyright", HYPERLITE_COPYRIGHT_STR
            VALUE "OriginalFilename", HYPERLITE_ORIGINAL_FILENAME
            VALUE "ProductName", "Hyperlite"
            VALUE "ProductVersion", HYPERLITE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // 0x409 english (US), 1200 unicode
        VALUE "Translation", 0x409, 1200
    END
END
