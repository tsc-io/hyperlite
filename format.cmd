@echo off
setlocal enableextensions enabledelayedexpansion

rem Applies the code style, or checks it: .editorconfig for C#, through dotnet format,
rem and .clang-format for C and C++, through the clang-format Visual Studio ships.
rem
rem   format.cmd           fixes every file in place
rem   format.cmd check     changes nothing, lists what is off and fails if anything is
rem
rem Only layout is applied - whitespace, braces, indentation. The naming and
rem the conventions .editorconfig also describes are suggestions the IDE makes, one at a
rem time, and are not rewritten in bulk here.
rem
rem deps\ is third-party code and keeps its own layout; Hyperlite.version.h is generated by
rem the build.

set mode=%1
if "%mode%" == "" set mode=fix
if not "%mode%" == "fix" if not "%mode%" == "check" (
    echo usage: format.cmd [check]
    exit /b 2
)

rem The clang-format of the Visual Studio 2026 find-msbuild.cmd finds: .clang-format needs
rem clang-format 20 or later, and the one Visual Studio 2022 ships is 19 - it would reject the
rem file and report every source as off.
call "%~dp0find-msbuild.cmd"
if errorlevel 1 exit /b 1
set clangformat=%vsroot%\VC\Tools\Llvm\x64\bin\clang-format.exe
if not exist "%clangformat%" (
    echo No clang-format found. Install the "C++ Clang tools for Windows" component of Visual Studio 2026.
    exit /b 1
)
rem printed, so that a check failing on one machine only shows which version it ran
"%clangformat%" --version

set failures=0
pushd "%~dp0"

echo === C# ===
if "%mode%" == "fix" (
    dotnet format whitespace --folder --exclude build dist deps TestResults
) else (
    dotnet format whitespace --folder --exclude build dist deps TestResults --verify-no-changes
)
if errorlevel 1 set /a failures+=1

echo === C and C++ ===
rem dir /s rather than for /r: for /r cannot take its root from another loop's variable
for /f "delims=" %%f in ('dir /s /b /a-d src\*.cpp src\*.h src\*.c tests\*.cpp tests\*.h tests\*.c bench\*.cpp bench\*.h bench\*.c 2^>nul') do (
    set file=%%f
    if "!file:\obj\=!" == "!file!" if "!file:\bin\=!" == "!file!" if /i not "%%~nxf" == "Hyperlite.version.h" (
        if "%mode%" == "fix" (
            "%clangformat%" -i --style=file "%%f"
        ) else (
            "%clangformat%" --dry-run -Werror --style=file "%%f" 2>nul
            if errorlevel 1 (
                echo %%f
                set /a failures+=1
            )
        )
    )
)

popd

echo.
if %failures% == 0 (
    if "%mode%" == "fix" (echo FORMAT OK) else (echo STYLE OK)
    exit /b 0
)
echo STYLE CHECK FAILED - run format.cmd to fix
exit /b 1
